{
  "manifest_version": 3,
  "name": "Alfa — magazyn (import ze sklepu)",
  "description": "Dodaje produkt ze strony sklepu dostawcy do towarów w Alfa (magazyn).",
  "version": "0.0.0",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": [
    "__ALFA_MATCH__",
    "https://*.samal.pl/*",
    "https://janexint.com.pl/*",
    "https://*.janexint.com.pl/*",
    "https://*.eltrox.pl/*",
    "https://*.grodno.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.samal.pl/*",
        "https://janexint.com.pl/*",
        "https://*.janexint.com.pl/*",
        "https://*.eltrox.pl/*",
        "https://*.grodno.pl/*"
      ],
      "js": ["config.js", "shops.js", "content-shop.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["__ALFA_MATCH__"],
      "js": ["config.js", "content-app.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Alfa — magazyn",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
